# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hr_interview
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=hr_interview

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Storage (S3-compatible)
STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=hr-interview-recordings
AWS_S3_ENDPOINT=

# Daily.co
DAILY_API_KEY=your-daily-api-key
DAILY_API_URL=https://api.daily.co/v1

# AI / AgentBase LLM (OpenAI-compatible)
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_API_KEY=
LLM_MODEL=
# TTS/STT models on AgentBase (model `path` from `aip.sh models list`); leave empty to fall back to direct OpenAI
TTS_MODEL=
STT_MODEL=
# Per-account whisper transcription base URL (from AI Platform console), e.g.
# https://maas-llm-aiplatform-hcm.api.vngcloud.vn/maas/user-XXXXXX/openai/whisper-large-v3/v1
STT_BASE_URL=
# Gemini prebuilt voice name for /speech/tts (e.g. Zephyr, Kore)
TTS_VOICE=Zephyr

# ElevenLabs speech (TTS + STT). Pick a Vietnamese-friendly voice id from your
# ElevenLabs dashboard/voice library. TTS uses /v1/text-to-speech/:voice_id and
# STT uses /v1/speech-to-text.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STT_MODEL=scribe_v2

# Legacy direct OpenAI fallback
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
# Optional provider override: elevenlabs, agentbase, or openai.
# Leave empty to auto-select ElevenLabs when ELEVENLABS_API_KEY is set.
TTS_PROVIDER=
STT_PROVIDER=

# App
PORT=3001
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:3001

# Email (Resend HTTP API). Leave RESEND_API_KEY empty in dev — invites/notifications are logged, not sent.
RESEND_API_KEY=
# Sender address. Must be onboarding@resend.dev until you verify your own domain at resend.com/domains.
MAIL_FROM="HR Interview <onboarding@resend.dev>"
# Candidate invitation link expiry, in days
INVITE_EXPIRY_DAYS=7

# Interview agent (orchestrator)
# AGENT_GREETING_TEXT="Xin chào! Tôi là trợ lý phỏng vấn AI..."
# AGENT_CLOSING_TEXT="Cảm ơn bạn đã hoàn thành buổi phỏng vấn..."
AGENT_LANGUAGE=vi
# Conversational follow-ups: max improvised follow-up questions per planned
# question (LLM-driven). Set 0 to disable (pure scripted, fixed questions).
INTERVIEW_MAX_FOLLOWUPS=2

# LiveKit Cloud (preferred video provider; falls back to Daily when unset)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Recording via egress — S3 storage must be PUBLICLY reachable (not local MinIO)
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_S3_REGION=us-east-1
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
LIVEKIT_EGRESS_S3_ENDPOINT=
